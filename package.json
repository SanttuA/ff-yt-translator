{
  "name": "yt-subtitle-translator",
  "version": "1.0.0",
  "private": true,
  "description": "Firefox add-on that translates YouTube captions with a local AI model. Dev tooling only; the add-on itself has no dependencies.",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "lint": "eslint . && web-ext lint --source-dir extension --warnings-as-errors",
    "test": "jest",
    "check": "npm run lint && npm test",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --filename yt-translator.xpi --overwrite-dest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "web-ext": "^10.7.0"
  }
}
